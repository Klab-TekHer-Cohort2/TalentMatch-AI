# --- Application ---
APP_NAME=TalentMatch AI
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database (PostgreSQL is the primary target) ---
# Create the database first:  createdb talentmatch
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/talentmatch
# Zero-setup local fallback (comment the line above and uncomment this one):
# DATABASE_URL=sqlite:///./talentmatch.db

# --- CORS (comma separated) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- File uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# --- Frontend ---
# Used to build password-reset links sent by email.
FRONTEND_URL=http://localhost:5173

# --- Applications ---
# Seekers cannot apply when their match score is below this percentage.
MIN_APPLY_MATCH_SCORE=50

# --- AI ---
# Leave ANTHROPIC_API_KEY empty to use deterministic local fallbacks.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
EMBEDDING_MODEL=all-MiniLM-L6-v2
# auto = try sentence-transformers, fall back to a local hashing embedder
EMBEDDING_BACKEND=auto

# --- Vector store ---
CHROMA_DIR=./chroma_data
VECTOR_COLLECTION=courses
RAG_TOP_K=4

# --- Password reset email (SMTP) ---
# Required to send "Forgot password" reset links. Without SMTP, the API returns 503.
# Example (Gmail): SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USE_TLS=true, use an App Password.
RESET_TOKEN_EXPIRE_MINUTES=60
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=TalentMatch AI
SMTP_USE_TLS=true
SMTP_USE_SSL=false
